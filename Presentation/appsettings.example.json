{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER;Database=UNIC;User Id=sa;Password=YOUR_PASSWORD;TrustServerCertificate=True;",
    "MeetingRoomConnection": "Server=YOUR_SERVER;Database=UNIC_MeetingRoom;User Id=sa;Password=YOUR_PASSWORD;TrustServerCertificate=True;",
    "RedisConnection": "localhost:6379"
  },
  "FileUpload": {
    "MaxFileSizeInMB": 5,
    "AllowedImageExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".gif",
      ".webp"
    ]
  },
  "Jwt": {
    "Key": "YOUR_JWT_KEY",
    "Issuer": "SecureApi",
    "Audience": "SecureApiUsers",
    "ExpireMinutes": 60
  },
  "Email": {
    "SmtpServer": "smtp.gmail.com",
    "SmtpPort": 587,
    "Username": "YOUR_EMAIL",
    "Password": "YOUR_APP_PASSWORD",
    "FromEmail": "YOUR_EMAIL",
    "FromName": "Member Management System"
  },
  "Cloudinary": {
    "CloudName": "YOUR_CLOUD_NAME",
    "ApiKey": "YOUR_API_KEY",
    "ApiSecret": "YOUR_API_SECRET"
  },
  "VnPay": {
    "PaymentBaseUrl": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
    "ReturnUrl": "https://localhost:7237/api/vnpay/return",
    "DefaultIpAddr": "127.0.0.1"
  },
  "AllowedHosts": "*"
}

